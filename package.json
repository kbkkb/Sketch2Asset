{
  "name": "sketch2asset",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "build:bin": "vite build && cargo build --manifest-path src-tauri/Cargo.toml --release --features tauri/custom-protocol && node -e \"import('fs').then(fs => fs.copyFileSync('src-tauri/target/release/Sketch2Asset.exe', 'bin/Sketch2Asset.exe'))\""
  },
  "dependencies": {
    "@lucide/svelte": "^1.60.0",
    "@tauri-apps/api": "^2.2.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.6",
    "@tauri-apps/cli": "^2.2.0",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
